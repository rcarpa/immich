# AltStore config for tools/build_release.sh — cp to altstore.env (gitignored).
# Only the --altstore route reads this.

# Where dist_altstore/all/ is served from: the IPAs, source.json and icon.png
# directly under it. Must be real HTTPS; AltStore refuses HTTP and self-signed.
ALTSTORE_BASE_URL="https://photos.example.com/altstore"

# Optional: serve dist_altstore/latest/ (one build, no history) somewhere else.
# Unset, it is written for ALTSTORE_BASE_URL as a partial upload over all/.
# Same source identifier either way, so subscribe to one URL, not both.
# ALTSTORE_LATEST_BASE_URL="https://photos.example.com/altstore-latest"

# Must match IMMICH_BUNDLE_ID_PROD in ios/Signing.local.xcconfig. Changing it
# later reads as a different app: empty database, whole mirror re-downloaded.
ALTSTORE_BUNDLE_ID="me.example.mirrich"

ALTSTORE_DEVELOPER="Your Name"

# Home-screen name, and the name AltStore lists. To run a build alongside an
# installed one, change this together with IMMICH_BUNDLE_ID_PROD, IMMICH_GROUP_ID
# and ALTSTORE_BUNDLE_ID — see BUILDING.md §4.2.
ALTSTORE_APP_NAME="Mirrich"

# Name AltStore lists the source under. Optional; an existing manifest keeps the
# name it has. When all/ and latest/ are served from different URLs, the full one
# is listed as "<name> (all builds)" so the two are tellable apart.
ALTSTORE_SOURCE_NAME=""
